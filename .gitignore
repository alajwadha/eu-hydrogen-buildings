.DS_Store
Thumbs.db
*.swp
*~

# Large auto-downloaded file (16 MB) — run download_data.py
code/data/raw/hotmaps/building_stock.csv

# Pilot raw data — large building geometry datasets, regenerable via 01_download.py
code/data/raw/eubucco/
code/data/raw/gba/

# GISCO NUTS3 boundary GeoJSON — large (~27 MB), auto-downloaded and cached
# by code/scripts/figures.py for the choropleth maps
code/data/raw/gisco/*.geojson

# Processed parquets — country builds produce large parquets that grow ~38 GB
# at 29-country scale. Policy 2b: parquets are gitignored, regenerable by
# running the country pipeline (01-03), or fetchable from the shared Drive folder
# (link in code/scripts/country_build/README.md).
code/data/processed/**/*.parquet

# Large MC sample outputs
code/results/mc_samples_*.parquet
code/results/mc_samples_*.csv

